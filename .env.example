# Configurações sensíveis — NÃO versionar este arquivo
DJANGO_SECRET_KEY=sua-chave-secreta-aqui-devcriar-uma-segura
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
# Google reCAPTCHA (secret key do projeto criado no console do Google)
RECAPTCHA_SECRET_KEY=

# Senha usada por create_superuser.py / reset_admin.py (se ausente, pede no prompt)
ADMIN_PASSWORD=

# Supabase Storage (S3-compatible)
SUPABASE_S3_ENDPOINT_URL=https://seu-projeto.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=sua-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=sua-secret-access-key
SUPABASE_S3_BUCKET_NAME=media
SUPABASE_S3_REGION_NAME=us-east-1
# Base de URLs públicas (opcional). Se vazio, é derivada automaticamente do
# endpoint acima (troca /storage/v1/s3 por /storage/v1/object/public/<bucket>).
# Use apenas se a URL pública do seu projeto divergir do padrão.
SUPABASE_S3_PUBLIC_URL=
